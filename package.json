{
  "name": "jotter",
  "version": "0.1.0",
  "description": "A fast, free, open-source desktop scratchpad for JavaScript, TypeScript, JSX and TSX with Node.js and browser runtimes, npm packages and snippets.",
  "homepage": "https://gitlab.com/wisftock/jotter",
  "author": {
    "name": "wisftock"
  },
  "maintainers": [
    "wisftock"
  ],
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "desktopName": "jotter.desktop",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/wisftock/jotter.git"
  },
  "bugs": {
    "url": "https://gitlab.com/wisftock/jotter/-/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "postinstall": "electron-builder install-app-deps",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:linux:appimage": "electron-vite build && electron-builder --linux AppImage",
    "build:linux:deb": "electron-vite build && electron-builder --linux deb",
    "build:linux:pacman": "electron-vite build && electron-builder --linux pacman",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "esbuild": "^0.28.2",
    "npm": "^12.2.0",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "app.jotter.desktop",
    "productName": "JOTTER",
    "copyright": "Copyright © 2026 JOTTER Maintainers",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "maintainer": "JOTTER Maintainers <maintainers@jotter.app>",
      "synopsis": "JavaScript playground for your desktop",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
